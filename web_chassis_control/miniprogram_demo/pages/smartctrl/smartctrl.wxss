@import '../../app.wxss';

.header-settings {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: var(--card); border: 1rpx solid var(--border);
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; cursor: pointer;
}

/* rviz */
.rviz-wrap {
  width: 100%;
  aspect-ratio: 16/9;
  background: #000;
  border-radius: 16rpx;
  border: 1rpx solid var(--border);
  overflow: hidden;
  position: relative;
  margin-bottom: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.rviz-full {
  position: fixed;
  inset: 0;
  width: 100vw; height: 100vh;
  aspect-ratio: unset;
  border-radius: 0;
  z-index: 300;
  margin-bottom: 0;
}
.rviz-placeholder { display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.rviz-icon  { font-size: 80rpx; opacity: 0.3; }
.rviz-hint  { font-size: 24rpx; color: var(--text3); }
.fullscreen-btn {
  position: absolute; bottom: 56rpx; right: 16rpx;
  width: 64rpx; height: 64rpx; border-radius: 12rpx;
  background: rgba(0,0,0,0.5); border: 1rpx solid rgba(255,255,255,0.2);
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; color: #fff; cursor: pointer;
}
.estop-btn {
  position: absolute; bottom: 16rpx;
  width: 90%; padding: 20rpx;
  border-radius: 12rpx; text-align: center;
  font-size: 28rpx; font-weight: 700; cursor: pointer;
}
.estop-locked   { background: rgba(255,59,92,0.3);  border: 1rpx solid var(--red);   color: var(--red); }
.estop-unlocked { background: rgba(0,230,118,0.2);  border: 1rpx solid var(--green); color: var(--green); }
.estop-text { }

/* 控制卡片列表 */
.ctrl-cards { width: 100%; display: flex; flex-direction: column; gap: 20rpx; }
.ctrl-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--border);
  background: var(--card);
  cursor: pointer;
  transition: all 0.15s;
}
.ctrl-card:active { background: var(--card-hover); }
.ctrl-card-active {
  border-color: var(--accent);
  background: rgba(0,229,255,0.06);
  box-shadow: 0 0 24rpx rgba(0,229,255,0.12);
}
.ctrl-card-left { display: flex; align-items: center; gap: 28rpx; flex: 1; }
.ctrl-icon { font-size: 52rpx; flex-shrink: 0; }
.ctrl-texts { display: flex; flex-direction: column; gap: 8rpx; }
.ctrl-name  { font-size: 30rpx; font-weight: 700; color: var(--text); }
.ctrl-desc  { font-size: 24rpx; color: var(--text2); }
.ctrl-chevron { font-size: 48rpx; color: var(--text3); }

/* 急停卡片变体 */
.estop-card-off { border-color: var(--red);   background: rgba(255,59,92,0.06); }
.estop-card-on  { border-color: var(--green); background: rgba(0,230,118,0.06); }

/* toggle 胶囊 */
.ctrl-toggle {
  padding: 10rpx 24rpx;
  border-radius: 40rpx;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.toggle-on  { background: rgba(0,230,118,0.15); color: var(--green); border: 1rpx solid var(--green); }
.toggle-off { background: rgba(255,59,92,0.10);  color: var(--red);   border: 1rpx solid var(--red); }
.toggle-label { }
