@import '../../app.wxss';

.page { position: relative; }
.fullscreen { padding: 0; }

.header-settings {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: var(--card); border: 1rpx solid var(--border);
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; cursor: pointer;
}

/* rviz 画面 */
.rviz-wrap {
  width: 100%;
  aspect-ratio: 16/9;
  background: #000;
  border-radius: 16rpx;
  border: 1rpx solid var(--border);
  overflow: hidden;
  position: relative;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rviz-full {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  aspect-ratio: unset;
  border-radius: 0;
  z-index: 300;
  margin-bottom: 0;
}
.rviz-placeholder {
  display: flex; flex-direction: column; align-items: center; gap: 16rpx;
}
.rviz-icon { font-size: 80rpx; opacity: 0.3; }
.rviz-hint { font-size: 24rpx; color: var(--text3); }
.fullscreen-btn {
  position: absolute;
  bottom: 16rpx; right: 16rpx;
  width: 64rpx; height: 64rpx;
  border-radius: 12rpx;
  background: rgba(0,0,0,0.5);
  border: 1rpx solid rgba(255,255,255,0.2);
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; color: #fff; cursor: pointer;
}

/* 控制区 */
.controls-wrap { width: 100%; }
.ctrl-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

/* 侧边按钮 */
.side-btn {
  display: flex; flex-direction: column; align-items: center; gap: 8rpx;
  padding: 24rpx 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--border);
  background: var(--card);
  min-width: 100rpx;
  cursor: pointer;
}
.side-btn:active { background: var(--card-hover); }
.side-btn-accent { border-color: var(--accent); background: rgba(0,229,255,0.06); }
.side-icon { font-size: 40rpx; }
.side-label { font-size: 20rpx; color: var(--text2); text-align: center; line-height: 1.4; }

/* D-pad */
.dpad-wrap { display: flex; flex-direction: column; align-items: center; }
.dpad-row { display: flex; align-items: center; }
.dpad-btn {
  width: 110rpx; height: 110rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--card); border: 1rpx solid var(--border);
  cursor: pointer; user-select: none;
}
.dpad-btn:active { background: rgba(0,229,255,0.15); }
.dpad-up    { border-radius: 16rpx 16rpx 0 0; }
.dpad-down  { border-radius: 0 0 16rpx 16rpx; }
.dpad-left  { border-radius: 16rpx 0 0 16rpx; }
.dpad-right { border-radius: 0 16rpx 16rpx 0; }
.dpad-center {
  width: 110rpx; height: 110rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(0,229,255,0.03); border: 1rpx solid var(--border);
}
.dpad-center-ring {
  width: 50rpx; height: 50rpx; border-radius: 50%;
  border: 2rpx solid rgba(0,229,255,0.25);
  background: radial-gradient(circle, rgba(0,229,255,0.12), transparent);
}
.dpad-arrow { font-size: 40rpx; color: var(--accent); text-shadow: 0 0 12rpx rgba(0,229,255,0.5); }

/* 底部按钮行 */
.bottom-row { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.bottom-btn {
  flex: 1; padding: 28rpx; border-radius: 16rpx;
  border: 1rpx solid var(--border); background: var(--card);
  text-align: center; font-size: 26rpx; color: var(--text); cursor: pointer;
}
.bottom-btn:active { background: var(--card-hover); }
.btn-unlocked { border-color: var(--green); color: var(--green); background: rgba(0,230,118,0.08); }
.btn-locked   { border-color: var(--red);   color: var(--red);   background: rgba(255,59,92,0.08); }

.back-row {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  padding: 28rpx; border-radius: 16rpx;
  border: 1rpx solid var(--border); background: var(--card); cursor: pointer;
}
.back-row:active { background: var(--card-hover); }
.back-icon { font-size: 32rpx; color: var(--accent); }
.back-text { font-size: 28rpx; color: var(--text); font-weight: 600; }

/* 保存弹窗 */
.modal-mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.65);
  display: flex; align-items: center; justify-content: center; z-index: 400;
}
.modal-box {
  width: 84%; background: var(--bg2);
  border: 1rpx solid var(--border); border-radius: 24rpx;
  padding: 48rpx 40rpx; display: flex; flex-direction: column; gap: 24rpx;
}
.modal-title { font-size: 32rpx; font-weight: 700; color: var(--text); text-align: center; }
.modal-warn {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 24rpx; border-radius: 12rpx;
  background: rgba(255,214,0,0.08); border: 1rpx solid rgba(255,214,0,0.25);
}
.modal-warn-icon { font-size: 32rpx; }
.modal-warn-text { font-size: 26rpx; color: var(--yellow); font-weight: 600; }
.modal-hint { font-size: 24rpx; color: var(--text2); line-height: 1.6; }
.modal-btns { display: flex; gap: 16rpx; }
.modal-btn {
  flex: 1; padding: 28rpx; border-radius: 12rpx;
  text-align: center; font-size: 28rpx; font-weight: 600; cursor: pointer;
}
.modal-cancel { border: 1rpx solid var(--border); color: var(--text2); }
.modal-confirm { background: linear-gradient(135deg, var(--accent2), var(--accent)); color: #fff; }
