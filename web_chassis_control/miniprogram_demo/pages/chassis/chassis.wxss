@import '../../app.wxss';

.header { gap: 12rpx; }
.header-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.header-status { font-size: 22rpx; font-weight: 600; letter-spacing: 2rpx; color: var(--text2); flex: 1; }
.header-settings {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: var(--card); border: 1rpx solid var(--border);
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; cursor: pointer;
}

/* 解锁卡片 */
.unlock-card {
  display: flex; align-items: center; gap: 24rpx;
  cursor: pointer; position: relative; overflow: hidden;
}
.unlock-card::before {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(120deg, rgba(0,229,255,0.06), transparent 60%);
  pointer-events: none;
}
.unlock-icon-wrap {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: rgba(0,229,255,0.10); border: 1rpx solid rgba(0,229,255,0.30);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.unlock-icon { font-size: 44rpx; }
.unlock-text-wrap { flex: 1; }
.unlock-label { display: block; font-size: 30rpx; font-weight: 600; color: var(--text); margin-bottom: 6rpx; }
.unlock-hint  { display: block; font-size: 26rpx; color: var(--text2); }
.unlock-pill  { padding: 8rpx 24rpx; border-radius: 40rpx; font-size: 22rpx; font-weight: 700; letter-spacing: 2rpx; }
.pill-on  { background: rgba(0,230,118,0.15); color: var(--green); border: 1rpx solid var(--green); }
.pill-off { background: rgba(255,59,92,0.12);  color: var(--red);   border: 1rpx solid var(--red); }

/* 速度卡片 */
.speed-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28rpx; }
.speed-label  { font-size: 30rpx; color: var(--text2); letter-spacing: 1rpx; }
.speed-val-box { display: flex; align-items: baseline; gap: 6rpx; }
.speed-val {
  font-size: 48rpx; font-weight: 700; color: var(--accent);
  font-variant-numeric: tabular-nums;
  text-shadow: 0 0 20rpx rgba(0,229,255,0.5);
}
.speed-unit { font-size: 26rpx; color: var(--text2); }
.slider-track-wrap { display: flex; align-items: center; gap: 16rpx; }
.slider-min, .slider-max { font-size: 26rpx; color: var(--text2); flex-shrink: 0; width: 56rpx; }
.slider-max { text-align: right; }
.speed-slider { flex: 1; margin: 0; }

/* D-pad */
.dpad-wrap {
  display: flex; flex-direction: column; align-items: center;
  margin-bottom: 36rpx;
}
.dpad-row { display: flex; align-items: center; justify-content: center; }
.dpad-btn {
  width: 160rpx; height: 160rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--card); border: 1rpx solid var(--border);
  user-select: none; -webkit-tap-highlight-color: transparent;
  cursor: pointer;
}
/* 方向键按下态：与灯光按钮风格一致 */
.dpad-btn:active {
  background: var(--card-hover);
  border-color: rgba(0,229,255,0.45);
}
.dpad-btn:active .dpad-arrow {
  color: rgba(0,229,255,0.72);
  text-shadow: 0 0 10rpx rgba(0,229,255,0.28);
}
/* 方向键按下效果（已修复 100% 生效） */
.dpad-btn-pressed {
  background: rgba(0,229,255,0.10) !important;
  border-color: var(--accent) !important;
  box-shadow: 0 0 24rpx rgba(0,229,255,0.2) !important;
}
.dpad-btn-pressed .dpad-arrow {
  color: var(--text) !important;
  text-shadow: 0 0 12rpx rgba(0,229,255,0.55) !important;
}
.dpad-up    { border-radius: 24rpx 24rpx 0 0; }
.dpad-down  { border-radius: 0 0 24rpx 24rpx; }
.dpad-left  { border-radius: 24rpx 0 0 24rpx; }
.dpad-right { border-radius: 0 24rpx 24rpx 0; }
.dpad-center {
  width: 160rpx; height: 160rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(0,229,255,0.03); border: 1rpx solid var(--border);
}
.dpad-center-ring {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  border: 2rpx solid rgba(0,229,255,0.25);
  background: radial-gradient(circle, rgba(0,229,255,0.12), transparent);
}
.dpad-arrow {
  font-size: 56rpx; color: var(--accent);
  text-shadow: 0 0 16rpx rgba(0,229,255,0.6); line-height: 1;
}

/* 灯光按钮行 */
.func-row {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}
.func-btn {
  width: 320rpx; 
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 20rpx 0;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  cursor: pointer;
}
.func-btn:active { background: var(--card-hover); }
.func-btn-active {
  background: rgba(0,229,255,0.10);
  border-color: var(--accent);
  box-shadow: 0 0 24rpx rgba(0,229,255,0.20);
}
.func-icon  { font-size: 44rpx; }
.func-label { font-size: 28rpx; color: var(--text); letter-spacing: 1rpx; font-weight: 700; }
/* ------------------------------------------------------------- */

/* 返回按钮 */
.back-row {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  width: 100%; padding: 32rpx; border-radius: 20rpx;
  border: 1rpx solid var(--border); background: var(--card);
  cursor: pointer;
}
.back-row:active { background: var(--card-hover); }
.back-icon { font-size: 32rpx; color: var(--accent); }
.back-text { font-size: 28rpx; color: var(--text); font-weight: 600; }
