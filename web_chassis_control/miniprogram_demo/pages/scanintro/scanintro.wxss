@import '../../app.wxss';

.intro-banner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 36rpx;
}
.banner-icon { font-size: 80rpx; }
.banner-title {
  font-size: 28rpx;
  color: var(--text2);
  letter-spacing: 2rpx;
}

.instructions-card { padding: 32rpx; }
.instruction-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 36rpx;
}
.instruction-item:last-child { margin-bottom: 0; }
.step-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent2), var(--accent));
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 0 16rpx rgba(0,229,255,0.3);
}
.step-no { font-size: 28rpx; font-weight: 700; color: #fff; }
.step-text { font-size: 28rpx; color: var(--text); line-height: 1.7; flex: 1; }

.warn-box {
  width: 100%;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 28rpx 32rpx;
  border-radius: 16rpx;
  background: rgba(255,214,0,0.08);
  border: 1rpx solid rgba(255,214,0,0.25);
  box-sizing: border-box;
  margin-bottom: 40rpx;
}
.warn-icon { font-size: 36rpx; flex-shrink: 0; }
.warn-text { font-size: 26rpx; color: var(--yellow); line-height: 1.6; }

.start-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 44rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, var(--accent2), var(--accent));
  box-shadow: 0 8rpx 32rpx rgba(0,229,255,0.25);
  cursor: pointer;
}
.start-btn:active { opacity: 0.85; }
.start-icon { font-size: 36rpx; color: #fff; }
.start-text { font-size: 34rpx; font-weight: 700; color: #fff; letter-spacing: 4rpx; }

.header-settings {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: var(--card); border: 1rpx solid var(--border);
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; cursor: pointer;
}
